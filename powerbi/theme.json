{
  "name": "Web Funnel Analytics",
  "dataColors": [
    "#1565C0",
    "#EF6C00",
    "#2E7D32",
    "#C62828",
    "#6A1B9A",
    "#455A64",
    "#AD1457",
    "#00838F"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1565C0",
  "good": "#2E7D32",
  "neutral": "#F9A825",
  "bad": "#C62828",
  "maximum": "#2E7D32",
  "center": "#F5F5F5",
  "minimum": "#C62828",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F2937"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5F6B7A"
    },
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 26,
      "color": "#0D2B4E"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2937"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "transparency": 85
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7F9FC"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}